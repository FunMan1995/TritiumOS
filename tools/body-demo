#!/usr/bin/env bash
# body-demo — Lab smoke for >BODY / to-body CREATE-body address mark (wave19 item 2 / docs/TO-BODY.md)
# Mirrors forth/tritium/kernel.fs body-demo + Linux host body_demo.
# Address mark only — not DOES> XT / linked XT / HERE bump.
# Forth mirror: to-body. Do NOT redefine host >BODY.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  echo "Usage: body-demo"
  echo "  dict-reset → create widget → to-body → [body-demo] OK"
  echo "  Markers: [body] >BODY name= → [body-demo] OK"
  echo "Root: $ROOT"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

fail() {
  echo "[body-demo] FAIL"
  exit 1
}

declare -a NAMES=()

dict_reset() {
  NAMES=()
}

entry_find() {
  local name=$1
  local i
  for i in "${!NAMES[@]}"; do
    if [[ "${NAMES[$i]}" == "$name" ]]; then
      echo "$i"
      return 0
    fi
  done
  echo "-1"
}

entry_create() {
  local name=$1
  NAMES+=("$name")
  local idx=$(( ${#NAMES[@]} - 1 ))
  echo "[kernel] created #$idx"
}

to_body() {
  local name=$1
  local i
  if [[ -z "$name" ]]; then
    echo "[body] FAIL reason=miss"
    return 1
  fi
  i=$(entry_find "$name")
  if [[ "$i" == "-1" ]]; then
    echo "[body] FAIL reason=miss"
    return 1
  fi
  # stub body-slot offset addr=0; xt= = entry index (host int only)
  echo "[body] >BODY name=${NAMES[$i]} addr=0 xt=$i"
}

echo "[body-demo] dict-reset + create widget + >BODY"
dict_reset

# 1) Ensure a known name exists so miss FAIL is avoided
entry_create widget
[[ "$(entry_find widget)" != "-1" ]] || fail

# 2) to-body / >BODY — greppable name= (+ addr=0 / xt=); no DOES> XT / HERE bump
to_body widget || fail

# Happy path must not emit miss FAIL; address mark only
echo "[body-demo] OK"
exit 0
