#!/usr/bin/env bash
# string-demo — Lab smoke for S" / ." / .( string-lit stubs (wave13 item 4 / docs/STRING-LIT.md)
# Mirrors forth/tritium/kernel.fs string-demo + Linux host string_demo.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  echo "Usage: string-demo"
  echo "  dict-reset → S\" hello\" + .\" world\" + .( hi)"
  echo "  Markers: [string] S\" / .\" / .( → [string-demo] OK"
  echo "Root: $ROOT"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

fail() {
  echo "[string-demo] FAIL"
  exit 1
}

declare -a NAMES=()
HITS=0
MISSES=0
SAW_S=0
SAW_DOT=0
SAW_PAREN=0

dict_reset() {
  NAMES=()
  HITS=0
  MISSES=0
  SAW_S=0
  SAW_DOT=0
  SAW_PAREN=0
}

entry_create() {
  local name=$1
  NAMES+=("$name")
  echo "[kernel] created #$(( ${#NAMES[@]} - 1 ))"
}

entry_find() {
  local name=$1
  local i
  for i in "${!NAMES[@]}"; do
    if [[ "${NAMES[$i]}" == "$name" ]]; then
      echo "$i"
      return 0
    fi
  done
  echo "-1"
}

# Stream scanner: comment skip then string-lit parse (mirrors host_interpret)
interpret() {
  local s=$1
  local i=0
  local len=${#s}
  HITS=0
  MISSES=0
  while (( i < len )); do
    while (( i < len )); do
      local c=${s:i:1}
      if [[ "$c" == ' ' || "$c" == $'\t' || "$c" == $'\n' || "$c" == $'\r' ]]; then
        (( i++ )) || true
      else
        break
      fi
    done
    (( i >= len )) && break
    local start=$i
    while (( i < len )); do
      local c=${s:i:1}
      if [[ "$c" == ' ' || "$c" == $'\t' || "$c" == $'\n' || "$c" == $'\r' ]]; then
        break
      fi
      (( i++ )) || true
    done
    local tok=${s:start:$((i - start))}

    if [[ "$tok" == '\' ]]; then
      while (( i < len )); do
        local c=${s:i:1}
        if [[ "$c" == $'\n' || "$c" == $'\r' ]]; then
          break
        fi
        (( i++ )) || true
      done
      if (( i < len )) && [[ "${s:i:1}" == $'\r' ]]; then (( i++ )) || true; fi
      if (( i < len )) && [[ "${s:i:1}" == $'\n' ]]; then (( i++ )) || true; fi
      echo "[comment] skip line"
      continue
    fi
    if [[ "$tok" == '(' ]]; then
      local found=0
      while (( i < len )); do
        if [[ "${s:i:1}" == ')' ]]; then
          (( i++ )) || true
          found=1
          break
        fi
        (( i++ )) || true
      done
      if [[ "$found" -eq 0 ]]; then
        echo "[comment] FAIL reason=unclosed"
      else
        echo "[comment] skip paren"
      fi
      continue
    fi

    # wave13 item 4: S" / ." / .(
    if [[ "$tok" == 'S"' || "$tok" == '."' || "$tok" == '.(' ]]; then
      local delim='"'
      [[ "$tok" == '.(' ]] && delim=')'
      # skip one leading blank
      if (( i < len )) && [[ "${s:i:1}" == ' ' || "${s:i:1}" == $'\t' ]]; then
        (( i++ )) || true
      fi
      local cstart=$i
      local found=0
      while (( i < len )); do
        local c=${s:i:1}
        if [[ "$c" == "$delim" ]]; then
          found=1
          break
        fi
        if [[ "$delim" == '"' && ( "$c" == $'\n' || "$c" == $'\r' ) ]]; then
          break
        fi
        (( i++ )) || true
      done
      if [[ "$found" -eq 0 ]]; then
        echo "[string] FAIL reason=unclosed"
      else
        local content=${s:cstart:$((i - cstart))}
        echo "[string] $tok $content"
        (( i++ )) || true  # consume delim
        case "$tok" in
          'S"') SAW_S=1 ;;
          '."') SAW_DOT=1 ;;
          '.(') SAW_PAREN=1 ;;
        esac
      fi
      continue
    fi

    local idx
    idx=$(entry_find "$tok")
    if [[ "$idx" == "-1" ]]; then
      echo "[interpret] miss name=$tok"
      (( MISSES++ )) || true
    else
      echo "[interpret] exec #$idx name=$tok"
      (( HITS++ )) || true
    fi
  done
}

echo "[string-demo] dict-reset + S\" / .\" / .("
dict_reset

interpret 'S" hello"'
[[ "$SAW_S" -eq 1 ]] || fail
[[ "$(entry_find hello)" == "-1" ]] || fail

interpret '." world"'
[[ "$SAW_DOT" -eq 1 ]] || fail
[[ "$(entry_find world)" == "-1" ]] || fail

interpret '.( hi)'
[[ "$SAW_PAREN" -eq 1 ]] || fail
[[ "$(entry_find hi)" == "-1" ]] || fail

# comment ( ) skip still works alongside .(
entry_create alpha
interpret 'alpha ( still comment )'
[[ "$HITS" -ge 1 ]] || fail
[[ "$(entry_find still)" == "-1" ]] || fail
[[ "$(entry_find comment)" == "-1" ]] || fail

echo "[string-demo] OK"
exit 0
