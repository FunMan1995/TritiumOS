#!/usr/bin/env bash
# comment-demo — Lab smoke for \ / ( ) comment skip stubs (wave12 item 3 / docs/COMMENT-PARSE.md)
# Mirrors forth/tritium/kernel.fs comment-demo + Linux host comment_demo.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  echo "Usage: comment-demo"
  echo "  dict-reset → known name → mixed \\ / ( ) streams"
  echo "  Markers: [comment] skip line/paren → [comment-demo] OK"
  echo "Root: $ROOT"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

fail() {
  echo "[comment-demo] FAIL"
  exit 1
}

declare -a NAMES=()
HITS=0
MISSES=0
SKIP_LINE=0
SKIP_PAREN=0

dict_reset() {
  NAMES=()
  HITS=0
  MISSES=0
  SKIP_LINE=0
  SKIP_PAREN=0
}

entry_create() {
  local name=$1
  NAMES+=("$name")
  echo "[kernel] created #$(( ${#NAMES[@]} - 1 ))"
}

entry_find() {
  local name=$1
  local i
  for i in "${!NAMES[@]}"; do
    if [[ "${NAMES[$i]}" == "$name" ]]; then
      echo "$i"
      return 0
    fi
  done
  echo "-1"
}

# Stream scanner: skip comments before find/exec (mirrors host_interpret)
interpret() {
  local s=$1
  local i=0
  local len=${#s}
  HITS=0
  MISSES=0
  while (( i < len )); do
    # skip whitespace
    while (( i < len )); do
      local c=${s:i:1}
      if [[ "$c" == ' ' || "$c" == $'\t' || "$c" == $'\n' || "$c" == $'\r' ]]; then
        (( i++ )) || true
      else
        break
      fi
    done
    (( i >= len )) && break
    # read token
    local start=$i
    while (( i < len )); do
      local c=${s:i:1}
      if [[ "$c" == ' ' || "$c" == $'\t' || "$c" == $'\n' || "$c" == $'\r' ]]; then
        break
      fi
      (( i++ )) || true
    done
    local tok=${s:start:$((i - start))}

    if [[ "$tok" == '\' ]]; then
      while (( i < len )); do
        local c=${s:i:1}
        if [[ "$c" == $'\n' || "$c" == $'\r' ]]; then
          break
        fi
        (( i++ )) || true
      done
      if (( i < len )) && [[ "${s:i:1}" == $'\r' ]]; then (( i++ )) || true; fi
      if (( i < len )) && [[ "${s:i:1}" == $'\n' ]]; then (( i++ )) || true; fi
      echo "[comment] skip line"
      SKIP_LINE=1
      continue
    fi
    if [[ "$tok" == '(' ]]; then
      local found=0
      while (( i < len )); do
        if [[ "${s:i:1}" == ')' ]]; then
          (( i++ )) || true
          found=1
          break
        fi
        (( i++ )) || true
      done
      if [[ "$found" -eq 0 ]]; then
        echo "[comment] FAIL reason=unclosed"
      else
        echo "[comment] skip paren"
        SKIP_PAREN=1
      fi
      continue
    fi

    local idx
    idx=$(entry_find "$tok")
    if [[ "$idx" == "-1" ]]; then
      echo "[interpret] miss name=$tok"
      (( MISSES++ )) || true
    else
      echo "[interpret] exec #$idx name=$tok"
      (( HITS++ )) || true
    fi
  done
}

echo "[comment-demo] dict-reset + mixed \\ / ( ) streams"
dict_reset
entry_create alpha

interpret $'alpha \\ this is a line comment\n'
[[ "$HITS" -ge 1 ]] || fail
[[ "$SKIP_LINE" -eq 1 ]] || fail
[[ "$(entry_find this)" == "-1" ]] || fail
[[ "$(entry_find is)" == "-1" ]] || fail
[[ "$(entry_find line)" == "-1" ]] || fail
[[ "$(entry_find comment)" == "-1" ]] || fail

entry_create beta
interpret 'alpha ( paren comment ) beta'
[[ "$HITS" -ge 2 ]] || fail
[[ "$SKIP_PAREN" -eq 1 ]] || fail
[[ "$(entry_find paren)" == "-1" ]] || fail
[[ "$(entry_find comment)" == "-1" ]] || fail
[[ "$(entry_find alpha)" != "-1" ]] || fail
[[ "$(entry_find beta)" != "-1" ]] || fail

echo "[comment-demo] OK"
exit 0
