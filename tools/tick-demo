#!/usr/bin/env bash
# tick-demo — Lab smoke for ' / ['] tick markers (wave18 item 1 / docs/TICK.md)
# Mirrors forth/tritium/kernel.fs tick-demo + Linux host tick_demo.
# Name→stub-xt-id mark only — NOT XT execute / FIND rewrite / COMPILE,.
# Forth mirrors: tick-mark / bracket-tick. Do NOT redefine host tick.
# ['] is flag echo only — does NOT compile XT into body.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  echo "Usage: tick-demo"
  echo "  dict-reset → create widget → tick-mark → bracket-tick → [tick-demo] OK"
  echo "  Markers: [tick] ' name= / [tick] ['] name= → [tick-demo] OK"
  echo "Root: $ROOT"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

fail() {
  echo "[tick-demo] FAIL"
  exit 1
}

declare -a NAMES=()

dict_reset() {
  NAMES=()
}

entry_find() {
  local name=$1
  local i
  for i in "${!NAMES[@]}"; do
    if [[ "${NAMES[$i]}" == "$name" ]]; then
      echo "$i"
      return 0
    fi
  done
  echo "-1"
}

entry_create() {
  local name=$1
  NAMES+=("$name")
  local idx=$(( ${#NAMES[@]} - 1 ))
  echo "[kernel] created #$idx"
}

tick_mark() {
  local name=$1
  local i
  i=$(entry_find "$name")
  if [[ "$i" == "-1" || -z "$name" ]]; then
    echo "[tick] FAIL reason=miss"
    return 1
  fi
  # stub xt id = entry index (host int only; not executable)
  echo "[tick] ' name=${NAMES[$i]} xt=$i i=$i"
}

bracket_tick() {
  local name=$1
  local i
  i=$(entry_find "$name")
  if [[ "$i" == "-1" || -z "$name" ]]; then
    echo "[tick] FAIL reason=miss"
    return 1
  fi
  # flag echo only — does NOT compile XT into body
  echo "[tick] ['] name=${NAMES[$i]} xt=$i"
}

echo "[tick-demo] dict-reset + create widget + tick-mark + bracket-tick"
dict_reset

# 1) Ensure a known name exists so miss FAIL is avoided
entry_create widget
[[ "$(entry_find widget)" != "-1" ]] || fail

# 2) ' / tick-mark — greppable name= (+ optional xt= / i=); no XT execute
tick_mark widget || fail

# 3) ['] / bracket-tick — greppable name= (+ optional xt=); no XT into body
bracket_tick widget || fail

# Happy path must not emit miss FAIL; no XT execute / COMPILE,
echo "[tick-demo] OK"
exit 0
